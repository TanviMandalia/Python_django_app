# ==============================================================================
# PhysioRehab Clinic - Environment Variables Template
# ==============================================================================

# --- Django Security ---
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- CSRF / Trusted Origins ---
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Database (Production - PostgreSQL) ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=physiorehab_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# --- SMTP Email Configuration ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=physiorehab.clinic.demo@gmail.com
EMAIL_HOST_PASSWORD=your_email_app_password
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=PhysioRehab Clinic <physiorehab.clinic.demo@gmail.com>

# --- Razorpay Payment Gateway ---
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# --- Stripe Payment Gateway ---
STRIPE_PUBLIC_KEY=pk_test_YourStripePublicKeyHere
STRIPE_SECRET_KEY=sk_test_YourStripeSecretKeyHere
STRIPE_WEBHOOK_SECRET=whsec_YourStripeWebhookSecretHere

# --- Clinic Direct UPI ID ---
CLINIC_UPI_ID=physiorehab@upi

# --- Celery & Broker ---
# Leave blank for local filesystem queue fallback, or provide Redis URL:
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
