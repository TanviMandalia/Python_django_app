# ==============================================================================
# PhysioRehab Clinic - Environment Variables Template (.env.example)
# Use this template for local development (.env) and production environments.
# Never commit real credentials, passwords, or production secrets to Git!
# ==============================================================================

# --- Application & Settings ---
DJANGO_SETTINGS_MODULE=myproject.settings.production
DEBUG=False

# --- Django Security & Hosts ---
# Generate using: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-secure-random-50-character-secret-key
ALLOWED_HOSTS=yourclinicdomain.com,www.yourclinicdomain.com
CSRF_TRUSTED_ORIGINS=https://yourclinicdomain.com,https://www.yourclinicdomain.com

# --- Canonical SEO Base URL ---
# Absolute production HTTPS domain used for canonical links, Open Graph, and sitemap.xml
CANONICAL_BASE_URL=https://yourclinicdomain.com

# --- HTTPS & Cookie Security (Production Defaults) ---
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# --- Database Configuration (PostgreSQL) ---
# OPTION 1: Unified connection string (preferred on Render, Railway, Heroku, AWS RDS)
DATABASE_URL=postgres://physio_user:your_secure_db_password@hostname:5432/physiorehab_db

# OPTION 2: Individual connection variables (used if DATABASE_URL is not provided)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=physiorehab_db
# DB_USER=postgres
# DB_PASSWORD=your_secure_db_password
# DB_HOST=localhost
# DB_PORT=5432
DB_CONN_MAX_AGE=600

# --- Email Provider Configuration ---
# IMPORTANT: Cloud platforms such as Render Free block outbound TCP traffic on SMTP ports (25, 465, 587).
# If you are hosting on Render Free, DO NOT use standard SMTP with Gmail, as connections will time out.
# Instead, use Resend HTTPS REST API (Option A).

# OPTION A: Resend Transactional Email API (RECOMMENDED for Render Free & Cloud)
# Bypasses cloud SMTP port blocks using HTTPS REST API (Port 443).
# Sign up at https://resend.com, generate an API key, and verify your sending domain.
# For testing without a verified domain, Resend allows sending to your account email with onboarding@resend.dev.
RESEND_API_KEY=re_your_resend_api_key_here
DEFAULT_FROM_EMAIL=PhysioRehab Clinic <onboarding@resend.dev>

# OPTION B: Standard SMTP Server (Gmail / Google Workspace / Amazon SES / SendGrid)
# Use ONLY on VPS, AWS, GCP, or hosting providers with unblocked outbound SMTP ports (587 / 465).
# For Gmail: You MUST enable 2-Step Verification and generate a 16-character "App Password"
# (Google Account -> Security -> 2-Step Verification -> App passwords). DO NOT use your personal Google account password!
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=your-clinic@gmail.com
# EMAIL_HOST_PASSWORD=abcd-efgh-ijkl-mnop
# DEFAULT_FROM_EMAIL=PhysioRehab Clinic <your-clinic@gmail.com>

# OPTION C: Local Testing Only
# Set ALLOW_CONSOLE_EMAIL_IN_PRODUCTION=True ONLY when intentionally running dry tests in production mode.
# ALLOW_CONSOLE_EMAIL_IN_PRODUCTION=False

# --- Webhook Authentication Secrets ---
# Secret token used by Resend, SendGrid, or mail relays to authenticate inbound and delivery status webhooks:
# Used at POST /api/email/inbound/ and POST /api/email/status-webhook/
INBOUND_EMAIL_WEBHOOK_SECRET=your_secure_webhook_secret_key_here
EMAIL_STATUS_WEBHOOK_SECRET=your_secure_webhook_secret_key_here

# --- Custom Domain DNS Setup (SPF, DKIM, DMARC) ---
# When sending from your custom clinic domain (e.g., mail.yourclinic.com), configure:
# 1. SPF: TXT @ "v=spf1 include:resend.com ~all" (or include:_spf.google.com for Google)
# 2. DKIM: CNAME / TXT record provided in your Resend / Google Workspace admin console.
# 3. DMARC: TXT _dmarc.yourclinic.com "v=DMARC1; p=none; rua=mailto:dmarc@yourclinic.com"

# --- Clinic Payment & UPI Configuration ---
CLINIC_UPI_ID=yourclinic@upi

# --- Doctor/Admin WhatsApp Destination for Appointment Requests ---
# Must be full international format without '+', spaces, dashes, or brackets (e.g. 919409510501).
# If unset or invalid, public WhatsApp direct submission is safely disabled and an admin notice is displayed.
DOCTOR_WHATSAPP_NUMBER=919409510501

# --- Google Business Profile & Places API (Reviews Integration) ---
# Used server-side to fetch verified Google Reviews, star rating, and review count.
# Never committed or exposed to frontend JavaScript.
# In Google Cloud Console:
#   1. Restrict API Key to "Places API"
#   2. Restrict Application to backend server IP addresses
GOOGLE_MAPS_API_KEY=your_google_places_api_key_here
# Verified Google Place ID for Dr. Dhvani Patalia Physio Rehab:
GOOGLE_PLACE_ID=your_verified_google_place_id_here
# Direct Google Review Writing URL (optional; if unset, auto-computed from GOOGLE_PLACE_ID):
# Example: https://search.google.com/local/writereview?placeid=ChIJ... or https://g.page/r/.../review
GOOGLE_REVIEW_URL=
# Cache duration in seconds (Default: 86400 = 24h, conforms to Google ToS max 30-day limit):
GOOGLE_REVIEWS_CACHE_TTL=86400


# --- Celery & Background Worker (Optional) ---
# Leave blank for local filesystem queue fallback, or provide Redis URL:
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Private Object Storage: Cloudflare R2 (S3-Compatible) ---
# Free Tier: 10 GB storage / month, 0 egress fees.
# If unset, application defaults to local FileSystemStorage.
# R2_BUCKET_NAME=your-clinic-private-docs
# R2_ACCOUNT_ID=your_cloudflare_account_id_hex
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_PRESIGNED_EXPIRY=3600

# --- Safe Initial Seed Credentials (Optional - only needed if running seed_users) ---
# If unset, seed_users assigns an unusable password to new accounts and preserves existing passwords.
# SEED_SUPERADMIN_PASSWORD=your_initial_superadmin_password
# SEED_CLINICADMIN_PASSWORD=your_initial_clinicadmin_password
# SEED_STAFF_PASSWORD=your_initial_staff_password
# SEED_PATIENT_PASSWORD=your_initial_patient_password
