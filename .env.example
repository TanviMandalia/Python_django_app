# ==============================================================================
# PhysioRehab Clinic - Environment Configuration Template
# ==============================================================================

# --- Django Security ---
DJANGO_SECRET_KEY=django-insecure-change-this-in-production-key-physiorehab-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- CSRF / Trusted Origins ---
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Database Configuration (Optional: SQLite default if omitted) ---
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=physiorehab_db
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# --- SMTP Email Configuration ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=physiorehab.clinic.demo@gmail.com
EMAIL_HOST_PASSWORD=dummy_dev_app_password
EMAIL_TIMEOUT=15

# --- Razorpay Payment Gateway ---
# Get your test/live keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# --- Clinic Direct UPI ID ---
CLINIC_UPI_ID=physiorehab@upi

# --- Celery & Redis (Background Tasks & Async Email) ---
# Local Windows Dev: Leave empty to use resilient filesystem broker
# Production Linux: Set to redis://localhost:6379/0 or amqp://localhost
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

