# ==============================================================================
# PhysioRehab Clinic - Environment Variables Template
# ==============================================================================

# --- Django Security ---
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# --- CSRF / Trusted Origins ---
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# --- Canonical SEO Base URL ---
# Absolute production HTTPS domain used for canonical links, Open Graph, and sitemap.xml
CANONICAL_BASE_URL=https://yourdomain.com

# --- Database (Production - PostgreSQL) ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=physiorehab_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# --- SMTP Email Configuration ---
# Production: django.core.mail.backends.smtp.EmailBackend
# Local dev:  django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-sender@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password_here
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=PhysioRehab Clinic <your-sender@gmail.com>

# --- Clinic Direct UPI ID (for QR-code / UPI payments) ---
CLINIC_UPI_ID=yourclinic@upi

# --- Celery & Broker ---
# Leave blank for local filesystem queue fallback, or provide Redis URL:
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
